# ============================================================================
#  复制到 /opt/projects/.env 后按需修改：
#      cp /opt/projects/env.example /opt/projects/.env
#
#  docker compose 会自动读取同目录的 .env
# ============================================================================

# ---------- law3（第三组 lawsys1，本项目）数据库与镜像 ----------
LAW3_MYSQL_ROOT_PASSWORD=frcs123456
LAW3_IMAGE_TAG=v1.0.0

# ---------- 大模型（OpenAI 兼容） ----------
# 方案 A：宿主机已装 Ollama（默认，容器通过 host.docker.internal 访问）
SPRING_AI_OPENAI_API_KEY=ollama
SPRING_AI_OPENAI_BASE_URL=http://host.docker.internal:11434
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=qwen2.5:7b-instruct

# 方案 B：用云端模型（例如 DeepSeek），把上面三行换成：
#   SPRING_AI_OPENAI_API_KEY=sk-xxxx
#   SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com     # 注意：不要带 /v1
#   SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-chat

# ---------- 向量模型（可选，留 false 走本地 3-gram 哈希向量） ----------
APP_EMBEDDING_ENABLED=false
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_BASE_URL=
APP_EMBEDDING_MODEL=text-embedding-v3
APP_EMBEDDING_PATH=/embeddings
APP_EMBEDDING_DIMENSIONS=1024

# ---------- 其他 ----------
# CourtListener 全文（可选）：不带 token 也能检索，只是拿不到完整判决原文
COURTLISTENER_API_KEY=
# 管理接口 /api/admin/grant-credits 的请求头 X-Admin-Secret
APP_ADMIN_SECRET=change-me-please
# 联调期可临时 true：注册/找回密码的邮箱验证码直接返回给前端
APP_AUTH_EXPOSE_CODE_IN_RESPONSE=false

# ---------- 其他组交付后按需填写（配合 enable-project.sh） ----------
# LAW1_IMAGE=lawllm1-api:v1.0.0
# LAW2_IMAGE=lawllm2-api:v1.0.0
# LAW4_IMAGE=lawsys2-api:v1.0.0
